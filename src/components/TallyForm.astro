---
/**
 * Écran sur-mesure du formulaire Tally (https://tally.so/r/<ID>) aux couleurs de l'enseigne.
 * L'identifiant se règle dans src/data/site.ts (`tallyId`) ou via la prop `formId`.
 */
import { SITE } from '../data/site';
import Icon from './Icon.astro';
interface Props { formId?: string; title?: string; intro?: string; id?: string; heading?: 'h2' | 'h3'; }
const {
  formId = SITE.tallyId,
  title = 'Demandez votre estimation gratuite',
  intro = 'Décrivez vos objets, joignez quelques photographies : un expert revient vers vous personnellement.',
  id = 'estimation',
  heading = 'h2',
} = Astro.props;
const H = heading;
const src = formId ? `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1` : '';
---
<section class="tally-section on-dark" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="grid tally-grid">
      <div class="tally-intro" data-reveal>
        <span class="kicker">Estimation gratuite</span>
        <H id={`${id}-title`} class="h-section">{title}</H>
        <p class="lead">{intro}</p>
        <ul class="reassure">
          <li class="glass"><Icon name="lock" /><div><b>Discrétion absolue</b><span>Votre dossier reste strictement confidentiel, de la première photo à la dernière signature.</span></div></li>
          <li class="glass"><Icon name="coins" /><div><b>Paiement direct</b><span>Règlement direct à l’acceptation de l’offre, sans intermédiaire ni commission.</span></div></li>
          <li class="glass"><Icon name="truck" /><div><b>Déplacement gratuit</b><span>Je viens chez vous dans toute la Nouvelle-Aquitaine et toute l’Occitanie.</span></div></li>
        </ul>
        <div class="tally-badges">
          <span><Icon name="shield" /> Sans engagement</span>
          <span><Icon name="seal" /> Expertise écrite sur demande</span>
          <span><Icon name="feather" /> Particuliers, notaires, héritiers</span>
        </div>
      </div>
      <div class="tally-box" data-reveal style="--i:1">
        <div class="tally-top"><Icon name="mail" /><div><b>Votre demande d’estimation</b><span>Quelques minutes suffisent. Les photographies sont facultatives mais très utiles.</span></div></div>
        <div class="tally-body">
          {src ? (
            <iframe data-tally-src={src} loading="lazy" title="Formulaire de demande d’estimation gratuite" width="100%" height="560" data-tally-fallback={src}></iframe>
          ) : (
            <div class="tally-placeholder" role="note"><h3>Formulaire Tally à intégrer ici</h3><p class="muted">Renseignez <code>tallyId</code> dans <code>src/data/site.ts</code>.</p></div>
          )}
        </div>
        {src && <p class="tally-foot">Le formulaire ne s’affiche pas ? <a href={`https://tally.so/r/${formId}`} target="_blank" rel="noopener noreferrer">Ouvrez-le dans un nouvel onglet</a>.</p>}
      </div>
    </div>
  </div>
</section>
{src && (
  <script is:inline>
    (function () {
      if (window.__tallyInit) return; window.__tallyInit = true;
      var frames = function () { return document.querySelectorAll('iframe[data-tally-src]'); };
      var fallback = function () { frames().forEach(function (f) { if (!f.getAttribute('src')) f.setAttribute('src', f.getAttribute('data-tally-fallback')); }); };
      var load = function () {
        var s = document.createElement('script');
        s.src = 'https://tally.so/widgets/embed.js';
        s.onload = function () { if (window.Tally) window.Tally.loadEmbeds(); else fallback(); setTimeout(fallback, 1500); };
        s.onerror = fallback;
        document.body.appendChild(s);
      };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { io.disconnect(); load(); } }, { rootMargin: '600px 0px' });
        var t = document.querySelector('.tally-box'); if (t) io.observe(t); else load();
      } else load();
    })();
  </script>
)}
