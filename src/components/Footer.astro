---
import { SITE, SPECIALITES, ESTIMATION_URL } from '../data/site';
import { REGIONS, zoneUrl } from '../data/territoires';
import { CITIES } from '../data/cities';
import { OBJETS } from '../data/objets';
import { creditLines, ALL_IMAGE_KEYS } from '../data/images';
const credits = creditLines(ALL_IMAGE_KEYS);
---
<footer class="site-footer">
  <div class="wrap" style="width:100%">
    <div class="f-cols">
      <div>
        <b>Zones d’intervention</b>
        <ul>
          {REGIONS.map((r) => <li><a href={zoneUrl(r.slug)}>{r.name}</a></li>)}
          {CITIES.slice(0, 7).map((c) => <li><a href={`/${c.slug}/`}>Antiquaire {c.name}</a></li>)}
        </ul>
      </div>
      <div>
        <b>Objets rachetés</b>
        <ul>{OBJETS.slice(0, 6).map((o) => <li><a href={`/objets/${o.slug}/`}>{o.name}</a></li>)}<li><a href="/objets/">Tous les objets →</a></li></ul>
      </div>
      <div>
        <b>Services</b>
        <ul>
          <li><a href="/rachat-succession/">Rachat de succession</a></li>
          <li><a href="/expertise-estimation/">Expertise d’objets d’art</a></li>
          <li><a href={ESTIMATION_URL}>Estimation gratuite</a></li>
          <li><a href="/a-propos/">À propos</a></li>
        </ul>
      </div>
      <div>
        <b>Nous écrire</b>
        <ul>
          <li>Toute la Nouvelle-Aquitaine et toute l’Occitanie, 25 départements.</li>
          {SITE.phone && <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
          {SITE.email && <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
        </ul>
        <a class="btn btn--gold f-cta" href={ESTIMATION_URL}>Demander une estimation <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
  <div class="wrap f-word" style="width:100%">
    <svg viewBox="0 0 1000 100" role="img" aria-label={SITE.wordmark}>
      <text x="0" y="78" font-size="84" textLength="1000" lengthAdjust="spacingAndGlyphs">{SITE.wordmark}</text>
    </svg>
    <details class="credits">
      <summary>Crédits photographiques</summary>
      <ul>{credits.map((c) => <li><a href={c.href} rel="noopener noreferrer">{c.text}</a></li>)}</ul>
    </details>
    <div class="f-legal">
      <span>© {new Date().getFullYear()} {SITE.name} – {SITE.tagline}</span>
      <span><a href="/mentions-legales/">Mentions légales</a> · <a href="/plan-du-site/">Plan du site</a></span>
    </div>
  </div>
</footer>
