---
import Pic from './Pic.astro';
import { ESTIMATION_URL } from '../data/site';
import { img as getImg } from '../data/images';
interface Props { alt?: string; h1: string; lead: string; img: string; trail: { name: string; path: string }[]; cta?: string; }
const { alt, h1, lead, img, trail, cta = 'Estimation gratuite' } = Astro.props;
const meta = getImg(img);
const portrait = meta.h > meta.w * 1.05;
---
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Fil d’Ariane">
      <ol>
        {trail.map((t, i) => <li>{i < trail.length - 1 ? <a href={t.path}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>)}
      </ol>
    </nav>
    <div class="grid ph-grid">
      <div class="ph-left">
        <h1 class="mask-h"><span class="mask"><span>{h1}</span></span></h1>
        <div class="ph-copy">
          <span class="kicker">Les Antiquités de Benjamin</span>
          <p class="lead">{lead}</p>
          <div class="cta-row">
            <a class="btn btn--terra" href={ESTIMATION_URL}>{cta} <span class="arr" aria-hidden="true">→</span></a>
            <a class="link" href="#faq-title">Questions fréquentes</a>
          </div>
        </div>
      </div>
      <div class:list={['ph-photo', portrait ? 'is-portrait' : 'is-landscape']} data-reveal><Pic k={img} alt={alt} eager sizes="(max-width: 860px) 92vw, 48vw" /></div>
    </div>
  </div>
</section>
