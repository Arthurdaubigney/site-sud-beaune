---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { organisationSchema, websiteSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: object[];
  trail?: { name: string; path: string }[];
  noindex?: boolean;
  preload?: string;
  preloadHero?: boolean;
}
const { title, description, ogImage = 'commode-louis-xv', jsonLd = [], trail, noindex = false, preload, preloadHero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const og = new URL(`/img/${ogImage}-1400.webp`, SITE.url).toString();
const isHome = Astro.url.pathname === '/';
const graph: object[] = [...(isHome ? [organisationSchema(), websiteSchema()] : []), ...jsonLd];
if (trail && trail.length > 1) graph.push(breadcrumbSchema(trail));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {preload && <link rel="preload" as="image" href={`/img/${preload}-1400.webp`} imagesrcset={`/img/${preload}-700.webp 700w, /img/${preload}-1400.webp 1400w`} imagesizes="(max-width: 860px) 72vw, 30vw" fetchpriority="high" />}
    {preloadHero && <link rel="preload" as="image" href="/img/hero-urtubie-1400.webp" imagesrcset="/img/hero-urtubie-1400.webp 1400w, /img/hero-urtubie-2400.webp 2400w" imagesizes="100vw" fetchpriority="high" />}
    {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
    {Astro.url.pathname !== '/estimation-gratuite/' && <a class="btn btn--terra sticky-cta" href="/estimation-gratuite/" data-sticky-cta>Estimation gratuite <span class="arr" aria-hidden="true">→</span></a>}
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach(function (e) { e.classList.add('in'); }); return;
        }
        var io = new IntersectionObserver(function (en) {
          en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        els.forEach(function (e) { io.observe(e); });
        var sc = document.querySelector('[data-sticky-cta]'); if (sc && document.getElementById('estimation')) sc.setAttribute('href', '#estimation');
        // Sélecteur de département
        var fd = document.querySelector('[data-finder]');
        if (fd) { fd.addEventListener('submit', function (e) { e.preventDefault(); var v = fd.querySelector('select').value; if (v) location.href = v; else location.href = '/zones-intervention/'; });
          fd.querySelector('select').addEventListener('change', function (e) { if (e.target.value) location.href = e.target.value; }); }
        // Carrousel des étapes
        var row = document.querySelector('[data-steps]');
        if (row) {
          var bar = document.querySelector('[data-progress]');
          var upd = function () {
            var max = row.scrollWidth - row.clientWidth;
            var w = Math.max(0.12, row.clientWidth / row.scrollWidth);
            var x = max > 0 ? row.scrollLeft / max : 0;
            if (bar) { bar.style.width = w * 100 + '%'; bar.style.marginLeft = x * (100 - w * 100) + '%'; }
          };
          row.addEventListener('scroll', upd, { passive: true }); upd();
          document.querySelectorAll('[data-dir]').forEach(function (b) {
            b.addEventListener('click', function () { row.scrollBy({ left: Number(b.getAttribute('data-dir')) * 312, behavior: 'smooth' }); });
          });
        }
      })();
    </script>
  </body>
</html>
