---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import TallyForm from '../components/TallyForm.astro';
import Faq from '../components/Faq.astro';
import { FAQ_GENERAL } from '../data/site';
import { faqSchema, serviceSchema } from '../lib/schema';
const path = '/estimation-gratuite/';
const trail = [{ name: 'Accueil', path: '/' }, { name: 'Estimation gratuite', path }];
const desc = 'Demandez une estimation gratuite de vos antiquités et objets d’art : formulaire en ligne, un expert vous répond en Nouvelle-Aquitaine et en Occitanie.';
const faq = FAQ_GENERAL.slice(0, 4);
---
<Base title="Estimation gratuite d’antiquités : formulaire en ligne" description={desc} ogImage="commode-louis-xv" trail={trail} jsonLd={[serviceSchema('Estimation gratuite d’antiquités', desc, path), faqSchema(faq)]}>
  <PageHero h1="Estimation gratuite de vos antiquités" lead="Décrivez vos objets, joignez des photographies : un expert vous répond, sans engagement." img="commode-louis-xv" trail={trail} cta="Remplir le formulaire" />
  <TallyForm title="Votre demande d’estimation" heading="h2" />
  <section class="section" aria-label="Quelques objets que nous estimons">
    <div class="wrap">
      <div class="grid pair pair-wide">
        <div class="a" data-reveal><Pic k="commode-wallace" ratio="16-10" sizes="(max-width: 860px) 92vw, 58vw" /></div>
        <div class="b" data-reveal style="--i:1"><Pic k="montre-gousset" ratio="3-4" sizes="(max-width: 860px) 70vw, 30vw" /></div>
      </div>
    </div>
  </section>
  <Faq items={faq} />
</Base>
