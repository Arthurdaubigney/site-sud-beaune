---
import Base from '../layouts/Base.astro';
import { ESTIMATION_URL } from '../data/site';
---
<Base title="Page introuvable – Les Antiquités de Benjamin" description="Cette page n’existe pas. Retrouvez nos antiquaires et experts d’art du Sud-Ouest depuis l’accueil ou demandez une estimation gratuite." noindex>
  <section class="page-hero"><div class="wrap">
    <h1 style="font-size:clamp(2.4rem,1rem + 5vw,5.4rem)">Cette page est introuvable</h1>
    <p class="lead" style="margin:32px 0">Elle a peut-être changé d’adresse. Revenez à l’accueil ou demandez une estimation.</p>
    <div class="cta-row"><a class="btn" href="/">Retour à l’accueil</a><a class="link" href={ESTIMATION_URL}>Estimation gratuite</a></div>
  </div></section>
</Base>
