---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pic from '../../components/Pic.astro';
import Band from '../../components/Band.astro';
import Prose from '../../components/Prose.astro';
import Faq from '../../components/Faq.astro';
import TallyForm from '../../components/TallyForm.astro';
import CtaPhoto from '../../components/CtaPhoto.astro';
import { SPECIALITES, FAQ_GENERAL } from '../../data/site';
import { REGIONS, FEATURED, zoneUrl } from '../../data/territoires';
import { serviceSchema, faqSchema } from '../../lib/schema';
import { IMG } from '../../lib/imageMap';

export function getStaticPaths() { return SPECIALITES.map((s) => ({ params: { slug: s.slug } })); }
const { slug } = Astro.params;
const s = SPECIALITES.find((x) => x.slug === slug)!;
const faq = [...s.faq, FAQ_GENERAL[1]];
const trail = [{ name: 'Accueil', path: '/' }, { name: 'Spécialités', path: '/antiquites/' }, { name: s.name, path: `/antiquites/${s.slug}/` }];
const path = `/antiquites/${s.slug}/`;
const second = IMG(`spec.${s.slug}.pair`);
const bandKey = IMG(`spec.${s.slug}.band`);
const ctaKey = IMG(`spec.${s.slug}.cta`);
---
<Base title={s.titleTag} description={s.metaDesc} ogImage={IMG(`spec.${s.slug}.hero`)} trail={trail} jsonLd={[serviceSchema(s.h1, s.metaDesc, path), faqSchema(faq)]}>
  <PageHero h1={s.h1} lead={s.lead} img={IMG(`spec.${s.slug}.hero`)} trail={trail} />
  <section class="section" aria-labelledby="sec-0">
    <div class="wrap">
      {s.sections.map((sec, i) => (
        <Prose h={sec.h} id={`sec-${i}`}>{sec.p.map((p) => <p>{p}</p>)}</Prose>
      ))}
      <Band k={bandKey} />
      <div class="grid prose-row" style="margin-top:96px">
        <h2 data-reveal>Ce que nous estimons et rachetons</h2>
        <ul class="points" data-reveal style="--i:1">{s.points.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="grid pair" style="margin-top:96px">
        <div class="a" data-reveal><Pic k={second} ratio="3-4" sizes="(max-width: 860px) 80vw, 33vw" /></div>
        <div class="b" data-reveal style="--i:1">
          <h2 style="font-size:clamp(1.8rem,1.1rem + 2vw,2.75rem)">Estimation près de chez vous</h2>
          <p style="margin-top:20px">Nous nous déplaçons gratuitement dans toute la Nouvelle-Aquitaine et toute l’Occitanie :</p>
          <ul class="related">
            {REGIONS.map((r) => <li><a class="chip" href={zoneUrl(r.slug)}>{s.kw} – {r.name}</a></li>)}
            {FEATURED.map((d) => <li><a class="chip" href={zoneUrl(d.slug)}>{s.kw} – {d.name}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <CtaPhoto k={ctaKey} />
  <Faq items={faq} title={`Questions fréquentes : ${s.kw}`} />
  <TallyForm />
</Base>
