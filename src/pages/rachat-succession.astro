---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import Band from '../components/Band.astro';
import Prose from '../components/Prose.astro';
import Faq from '../components/Faq.astro';
import TallyForm from '../components/TallyForm.astro';
import CtaPhoto from '../components/CtaPhoto.astro';
import { REGIONS, FEATURED, zoneUrl } from '../data/territoires';
import { IMG } from '../lib/imageMap';
import { serviceSchema, faqSchema } from '../lib/schema';
const path = '/rachat-succession/';
const trail = [{ name: 'Accueil', path: '/' }, { name: 'Rachat de succession', path }];
const faq = [
  { q: 'Que faire du contenu d’une maison après un décès ?', a: 'Ne jetez rien avant de nous consulter. Nous réalisons un inventaire, identifions les objets de valeur, rachetons ce qui présente un intérêt et pouvons organiser le débarras du reste.' },
  { q: 'Travaillez-vous avec les notaires et les héritiers ?', a: 'Oui. Nous remettons une estimation écrite exploitable par le notaire pour le partage, et nous adaptons à la présence de plusieurs héritiers.' },
  { q: 'Comment se déroule le rachat ?', a: 'Après l’estimation et la visite, une proposition ferme est remise. En cas d’accord, l’enlèvement est organisé et le paiement effectué par virement sécurisé.' },
  { q: 'Dois-je trier avant votre visite ?', a: 'Non. Laissez les objets en place : nous les voyons dans leur contexte, ce qui aide à les dater et à les attribuer.' },
];
const desc = 'Rachat de succession et de contenu de maison : inventaire, estimation gratuite et paiement sécurisé en Nouvelle-Aquitaine et en Occitanie.';
---
<Base title="Rachat de succession : antiquités et objets d’art à domicile" description={desc} ogImage={IMG('rachat.hero')} trail={trail} jsonLd={[serviceSchema('Rachat de succession d’antiquités', desc, path), faqSchema(faq)]}>
  <PageHero h1="Rachat de succession et de contenu de maison" lead="Une succession demande du temps et de la discrétion : nous inventorions, estimons et rachetons les objets d’art de la famille." img={IMG('rachat.hero')} trail={trail} cta="Parler de ma succession" />
  <section class="section" aria-labelledby="s-0">
    <div class="wrap">
      <Prose h="Un accompagnement pensé pour les familles" id="s-0">
        <p>Qu’il s’agisse d’une maison de famille, d’un appartement ou d’un château, nous intervenons avec respect et sans précipitation. Notre rôle : déterminer ce qui a de la valeur, expliquer pourquoi et proposer un rachat transparent.</p>
        <p>Nous travaillons avec les héritiers, les notaires, les mandataires judiciaires et les administrateurs de biens, dans les 25 départements de Nouvelle-Aquitaine et d’Occitanie.</p>
      </Prose>
      <Prose h="Ce que nous rachetons">
        <p>Mobilier ancien, tableaux, bronzes, sculptures, bijoux, montres, pendules, porcelaines, argenterie, livres anciens, tapis, souvenirs de famille et objets de collection.</p>
        <p><a href="/antiquites/">Voir toutes nos spécialités</a></p>
      </Prose>
      <Band k={IMG('rachat.band')} />
      <div class="grid pair" style="margin-top:96px">
        <div class="a" data-reveal><Pic k={IMG('rachat.pair')} ratio="4-5" sizes="(max-width: 860px) 80vw, 33vw" /></div>
        <div class="b" data-reveal style="--i:1">
          <h2 style="font-size:clamp(1.8rem,1.1rem + 2vw,2.75rem)">Une succession près de chez vous</h2>
          <ul class="related">
            {REGIONS.map((r) => <li><a class="chip" href={zoneUrl(r.slug)}>Succession {r.name}</a></li>)}
            {FEATURED.map((d) => <li><a class="chip" href={zoneUrl(d.slug)}>Succession {d.name}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <CtaPhoto k={IMG('rachat.cta')} />
  <Faq items={faq} title="Questions fréquentes sur le rachat de succession" />
  <TallyForm title="Parlez-nous de votre succession" intro="Quelques lignes et des photographies : nous revenons vers vous." />
</Base>
