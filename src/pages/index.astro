---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import TallyForm from '../components/TallyForm.astro';
import CtaPhoto from '../components/CtaPhoto.astro';
import { SPECIALITES, FAQ_GENERAL, ESTIMATION_URL } from '../data/site';
import { REGIONS, DEPTS, FEATURED, deptsOf, zoneUrl } from '../data/territoires';
import { faqSchema } from '../lib/schema';
import { CITIES } from '../data/cities';
import { GUIDES } from '../data/guides';
import { SERVICES } from '../data/services';

const faq = FAQ_GENERAL;
// Projection simple longitude/latitude -> SVG (viewBox 300 x 262)
const proj = (lon: number, lat: number) => ({ x: Math.round((lon + 2.2) * 48), y: Math.round((47 - lat) * 66) + 8 });
const mapPts = [
  { n: 'Poitiers', lon: 0.34, lat: 46.58, d: 'vienne-86', a: 'start' },
  { n: 'La Rochelle', lon: -1.15, lat: 46.16, d: 'charente-maritime-17', a: 'start' },
  { n: 'Limoges', lon: 1.26, lat: 45.83, d: 'haute-vienne-87', a: 'start' },
  { n: 'Périgueux', lon: 0.72, lat: 45.18, d: 'dordogne-24', a: 'start' },
  { n: 'Bordeaux', lon: -0.58, lat: 44.84, d: 'gironde-33', a: 'end' },
  { n: 'Cahors', lon: 1.44, lat: 44.45, d: 'lot-46', a: 'end' },
  { n: 'Rodez', lon: 2.57, lat: 44.35, d: 'aveyron-12', a: 'start' },
  { n: 'Biarritz', lon: -1.56, lat: 43.48, d: 'pyrenees-atlantiques-64', a: 'start' },
  { n: 'Toulouse', lon: 1.44, lat: 43.6, d: 'haute-garonne-31', a: 'end' },
  { n: 'Albi', lon: 2.15, lat: 43.93, d: 'tarn-81', a: 'start' },
  { n: 'Nîmes', lon: 4.36, lat: 43.84, d: 'gard-30', a: 'start' },
  { n: 'Montpellier', lon: 3.88, lat: 43.61, d: 'herault-34', a: 'end' },
  { n: 'Perpignan', lon: 2.9, lat: 42.7, d: 'pyrenees-orientales-66', a: 'start' },
].map((p) => ({ ...p, ...proj(p.lon, p.lat) }));
const steps = [
  { t: 'Vous m’écrivez', d: 'Quelques lignes et des photographies suffisent : décrivez vos objets, leur origine, leur lieu.', i: 'camera' },
  { t: 'J’estime', d: 'J’examine vos clichés et vous remets une première fourchette de valeur, gratuitement.', i: 'search' },
  { t: 'Je viens chez vous', d: 'Visite à domicile sans engagement, à l’heure qui vous convient, dans tout le Grand Sud-Ouest.', i: 'door' },
  { t: 'J’expertise', d: 'Inventaire, datation, attribution : un rapport écrit si vous le souhaitez, pour votre notaire ou votre assurance.', i: 'seal' },
  { t: 'Je vous propose un rachat', d: 'Offre ferme, objet par objet ou en bloc. Vous décidez, sans pression.', i: 'coins' },
  { t: 'Je règle et j’enlève', d: 'Paiement direct, enlèvement et transport assurés par mes soins.', i: 'truck' },
];
const specs = SPECIALITES.map((s) => ({ href: `/antiquites/${s.slug}/`, name: s.name, k: s.img, text: s.lead.split(':')[0], title: `${s.name} : expertise et estimation gratuite` }));
specs.push({ href: '/rachat-succession/', name: 'Rachat de succession', k: 'boutique-antiquites', text: 'Inventaire, partage et rachat du contenu d’une maison', title: 'Rachat de succession : inventaire, estimation et rachat' });
const trust = [
  { i: 'shield', b: 'Estimation gratuite', s: 'Sans engagement, à partir de vos photographies' },
  { i: 'truck', b: 'Déplacement gratuit', s: 'Partout en Nouvelle-Aquitaine et en Occitanie' },
  { i: 'coins', b: 'Paiement direct', s: 'Règlement à l’acceptation de l’offre' },
  { i: 'lock', b: 'Discrétion garantie', s: 'Un interlocuteur unique, en toute confidentialité' },
];
---
<Base
  title="Antiquaire expert Sud-Ouest : estimation gratuite, succession"
  description="Les Antiquités de Benjamin : antiquaire et cabinet d’expertise en Nouvelle-Aquitaine et Occitanie. Estimation gratuite, rachat de succession et d’objets d’art."
  ogImage="hero-urtubie"
  jsonLd={[faqSchema(faq)]}
  preloadHero
>
  <section class="hero-full">
    <img src="/img/hero-urtubie-2400.webp" srcset="/img/hero-urtubie-1400.webp 1400w, /img/hero-urtubie-2400.webp 2400w" sizes="100vw" width="2400" height="1600" alt="Salon d’un château du Pays basque avec tapisserie, pendule comtoise et mobilier ancien" title="Salon de château du Pays basque – antiquités et mobilier ancien" fetchpriority="high" decoding="sync" />
    <div class="wrap hero-inner">
      <span class="hero-badge glass"><i></i>Maison fondée dans le Sud-Ouest</span>
      <h1 class="hero-title">
        <span class="mask l1"><span>Antiquaire expert</span></span>
        <span class="mask l2"><span>du Grand Sud-Ouest</span></span>
      </h1>
      <p class="hero-lead">Les Antiquités de Benjamin, cabinet d’expertise itinérant : estimation gratuite, rachat de succession et d’objets d’art dans toute la Nouvelle-Aquitaine et toute l’Occitanie, de la Charente au Pays basque, du Périgord au Gard et à l’Hérault.</p>
      <div class="cta-row hero-cta">
        <a class="btn btn--terra btn--lg" href={ESTIMATION_URL}>Estimation gratuite <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn--glass btn--lg" href="/rachat-succession/">Rachat de succession</a>
      </div>
      <ul class="hero-trust">
        {trust.map((t) => (
          <li class="trust-item glass"><Icon name={t.i} /><div><b>{t.b}</b><span>{t.s}</span></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-about">
    <div class="wrap">
      <div class="grid">
        <div class="about-head" data-reveal>
          <span class="kicker">Antiquaire passionné</span>
          <h2 class="h-section" id="h-about">Tout le Sud-Ouest, une seule expertise</h2>
          <span class="ornament"></span>
          <p class="lead" style="margin-top:26px">Vingt-cinq départements, une même exigence : estimer juste, racheter avec respect, accompagner les familles avec discrétion.</p>
        </div>
      </div>
      <div class="grid mosaic">
        <div class="mosaic-photo" data-reveal>
          <Pic k="vezere" sizes="(max-width: 860px) 92vw, 48vw" />
          <div class="paper-block"><p>De la Charente-Maritime aux Pyrénées-Orientales, je connais les demeures, les ateliers et les marchés de chaque territoire. J’estime vos objets d’art avec la rigueur d’un cabinet d’expertise.</p></div>
        </div>
        <div class="mosaic-side" data-reveal style="--i:1">
          <div class="tile">
            <svg class="map" viewBox="0 0 360 300" role="img" aria-label="Carte des zones d’intervention en Nouvelle-Aquitaine et en Occitanie">
              {mapPts.map((p) => (
                <a href={zoneUrl(p.d)}>
                  <title>{`Antiquaire à ${p.n}`}</title>
                  <circle cx={p.x} cy={p.y} r="4.5" />
                  <text x={p.a === 'end' ? p.x - 9 : p.x + 9} y={p.y + 4} text-anchor={p.a}>{p.n}</text>
                </a>
              ))}
            </svg>
          </div>
        </div>
      </div>
      <dl class="facts" data-reveal>
        <div><dt>Départements couverts</dt><dd>Vingt-cinq</dd></div>
        <div><dt>Régions</dt><dd>Deux</dd></div>
        <div><dt>Estimation</dt><dd>Gratuite</dd></div>
        <div><dt>Engagement</dt><dd>Aucun</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="h-band">
    <div class="wrap band-head" data-reveal>
      <span class="kicker">Zones d’intervention</span>
      <h2 class="h-section" id="h-band">Dans toutes les grandes villes</h2>
    </div>
    <div class="wrap">
      <div class="band" data-reveal>
        {[['gironde-33', 'bordeaux-bourse', 'Bordeaux'], ['haute-garonne-31', 'toulouse', 'Toulouse'], ['pyrenees-atlantiques-64', 'biarritz', 'Biarritz'], ['herault-34', 'montpellier', 'Montpellier']].map(([slug, k, city], i) => (
          <a href={zoneUrl(slug)} style={`--g:${[4, 3, 3, 3][i]}`} title={`Antiquaire à ${city}`}>
            <Pic k={k} sizes="(max-width: 860px) 60vw, 40vw" alt={`Antiquaire expert à ${city} : estimation gratuite et rachat`} />
            <span class="scrim"></span>
            <span class="cap">{city}</span>
          </a>
        ))}
      </div>
      <p class="small muted band-note">Et dans tous les autres départements : <a href="/zones-intervention/">voir toutes les zones d’intervention</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="h-steps">
    <div class="wrap">
      <div class="steps-top" data-reveal>
        <div>
          <span class="kicker">Ma méthode</span>
          <h2 class="h-section" id="h-steps">De votre message au règlement</h2>
        </div>
        <div class="ctrl"><button class="sq" data-dir="-1" aria-label="Étape précédente">←</button><button class="sq" data-dir="1" aria-label="Étape suivante">→</button></div>
      </div>
      <div class="progress" aria-hidden="true"><i data-progress></i></div>
      <ol class="steps-row" data-steps tabindex="0" aria-label="Les étapes d’une estimation">
        {steps.map((s) => (
          <li class="step">
            <span class="step-ico"><Icon name={s.i} /></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="h-spec">
    <div class="wrap">
      <div data-reveal>
        <span class="kicker">Spécialités</span>
        <h2 class="h-section" id="h-spec">Ce que j’expertise</h2>
        <span class="ornament"></span>
      </div>
      <div class="scards">
        {specs.map((c, i) => (
          <a class="scard" href={c.href} title={c.title} data-reveal style={`--i:${i % 3}`}>
            <Pic k={c.k} ratio="4-3" sizes="(max-width: 600px) 92vw, (max-width: 960px) 46vw, 30vw" />
            <div class="scard-body"><h3>{c.name}</h3><p>{c.text}</p><span class="more">Découvrir <span class="arr" aria-hidden="true">→</span></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-zones">
    <div class="wrap">
      <div class="grid zones-grid">
        <div class="zones-intro" data-reveal>
          <span class="kicker">Partout chez vous</span>
          <h2 class="h-section" id="h-zones">Partout dans le Sud-Ouest</h2>
          <p class="lead" style="margin-top:22px">Toute la Nouvelle-Aquitaine et toute l’Occitanie : choisissez votre département.</p>
          <form class="finder card" data-finder>
            <label for="dep-select" class="finder-label">Votre département</label>
            <div class="finder-row">
              <select id="dep-select" name="dep">
                <option value="">Sélectionner…</option>
                {REGIONS.map((r) => (
                  <optgroup label={r.name}>
                    {deptsOf(r.slug).map((d) => <option value={zoneUrl(d.slug)}>{d.name} ({d.num})</option>)}
                  </optgroup>
                ))}
              </select>
              <button class="btn" type="submit">Voir</button>
            </div>
          </form>
        </div>
        <div class="zones-list">
          {REGIONS.map((r, i) => (
            <div class="card" data-reveal style={`--i:${i}`}>
              <h3><a href={zoneUrl(r.slug)}>{r.name}</a></h3>
              <p>{deptsOf(r.slug).map((d, n, arr) => (<><a href={zoneUrl(d.slug)} title={`Antiquaire ${d.name} (${d.num}) : ${d.cities.slice(0, 3).join(', ')}`}>{d.name}</a>{n < arr.length - 1 ? ', ' : '.'}</>))}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-guides">
    <div class="wrap">
      <div data-reveal>
        <span class="kicker">Conseils d’antiquaire</span>
        <h2 class="h-section" id="h-guides">Les questions que se posent les héritiers</h2>
        <span class="ornament"></span>
      </div>
      <div class="gcards">
        {GUIDES.slice(0, 3).map((g, i) => (
          <a class="gcard" href={`/conseils/${g.slug}/`} data-reveal style={`--i:${i}`}>
            <span class="gmeta">{g.minutes} min de lecture</span>
            <h3>{g.h1}</h3>
            <p>{g.lead}</p>
            <span class="more">Lire le guide <span class="arr" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <p class="band-note" style="margin-top:28px"><a class="link" href="/conseils/">Tous nos conseils (meubles, bijoux, argenterie, tableaux…) →</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="h-cities">
    <div class="wrap">
      <div class="grid zones-grid">
        <div class="zones-intro" data-reveal>
          <span class="kicker">Antiquaire près de chez vous</span>
          <h2 class="h-section" id="h-cities">Antiquaire dans votre ville</h2>
          <p class="lead" style="margin-top:22px">Estimation gratuite et rachat à domicile dans les principales villes du Sud-Ouest, et dans toutes les communes alentour.</p>
        </div>
        <div class="zones-list">
          <div class="card" data-reveal>
            <h3>Villes desservies</h3>
            <p>{CITIES.map((c, n) => (<><a href={`/${c.slug}/`}>{c.name}</a>{n < CITIES.length - 1 ? ', ' : '.'}</>))}</p>
          </div>
          <div class="card" data-reveal style="--i:1">
            <h3>Ce que je fais pour vous</h3>
            <p>{SERVICES.map((x, n) => (<><a href={`/${x.slug}/`}>{x.h1}</a>{n < SERVICES.length - 1 ? ', ' : '.'}</>))}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaPhoto k="perigord-chateau" title="Une succession à régler ?" text="Je rachète le contenu complet d’une maison : mobilier, tableaux, bijoux et objets d’art. Estimation gratuite, discrétion assurée." label="Parler de ma succession" href="/rachat-succession/" />
  <Faq items={faq} title="Vos questions sur l’estimation" />
  <TallyForm />
</Base>
