---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Faq from '../components/Faq.astro';
import TallyForm from '../components/TallyForm.astro';
import CtaPhoto from '../components/CtaPhoto.astro';
import { SPECIALITES, FAQ_GENERAL, ESTIMATION_URL } from '../data/site';
import { REGIONS, DEPTS, FEATURED, deptsOf, zoneUrl } from '../data/territoires';
import { faqSchema } from '../lib/schema';

const faq = FAQ_GENERAL;
// Projection simple longitude/latitude -> SVG (viewBox 300 x 262)
const proj = (lon: number, lat: number) => ({ x: Math.round((lon + 2.2) * 48), y: Math.round((47 - lat) * 66) + 8 });
const mapPts = [
  { n: 'Poitiers', lon: 0.34, lat: 46.58, d: 'vienne-86', a: 'start' },
  { n: 'La Rochelle', lon: -1.15, lat: 46.16, d: 'charente-maritime-17', a: 'start' },
  { n: 'Limoges', lon: 1.26, lat: 45.83, d: 'haute-vienne-87', a: 'start' },
  { n: 'Périgueux', lon: 0.72, lat: 45.18, d: 'dordogne-24', a: 'start' },
  { n: 'Bordeaux', lon: -0.58, lat: 44.84, d: 'gironde-33', a: 'end' },
  { n: 'Cahors', lon: 1.44, lat: 44.45, d: 'lot-46', a: 'end' },
  { n: 'Rodez', lon: 2.57, lat: 44.35, d: 'aveyron-12', a: 'start' },
  { n: 'Biarritz', lon: -1.56, lat: 43.48, d: 'pyrenees-atlantiques-64', a: 'start' },
  { n: 'Toulouse', lon: 1.44, lat: 43.6, d: 'haute-garonne-31', a: 'end' },
  { n: 'Albi', lon: 2.15, lat: 43.93, d: 'tarn-81', a: 'start' },
  { n: 'Nîmes', lon: 4.36, lat: 43.84, d: 'gard-30', a: 'start' },
  { n: 'Montpellier', lon: 3.88, lat: 43.61, d: 'herault-34', a: 'end' },
  { n: 'Perpignan', lon: 2.9, lat: 42.7, d: 'pyrenees-orientales-66', a: 'start' },
].map((p) => ({ ...p, ...proj(p.lon, p.lat) }));
const steps = [
  { t: 'Vous nous écrivez', d: 'Quelques lignes et des photographies suffisent : décrivez vos objets, leur origine, leur lieu.', k: 'commode-wallace', g: 100 },
  { t: 'Nous estimons sous 48 h', d: 'Un expert examine vos clichés et vous remet une première fourchette de valeur, gratuitement.', k: 'montre-gousset', g: 60 },
  { t: 'Nous venons chez vous', d: 'Visite à domicile sans engagement, à l’heure qui vous convient, dans tout le Grand Sud-Ouest.', k: 'vase-porcelaine', g: 130 },
  { t: 'Nous expertisons', d: 'Inventaire, datation, attribution : un rapport écrit si vous le souhaitez, pour votre notaire ou votre assurance.', k: 'pendule-xviii', g: 80 },
  { t: 'Nous vous proposons un rachat', d: 'Offre ferme, objet par objet ou en bloc. Vous décidez, sans pression.', k: 'bronze-sculpture', g: 110 },
  { t: 'Nous réglons et enlevons', d: 'Paiement par virement sécurisé, enlèvement et transport assurés par nos soins.', k: 'marqueterie-boulle', g: 70 },
];
---
<Base
  title="Antiquaire expert Sud-Ouest : estimation gratuite, succession"
  description="Antiquaires et experts en objets d’art de la Charente au Pays basque, Périgord, Bordeaux, Gard et Hérault : estimation gratuite, rachat de succession."
  ogImage="commode-louis-xv"
  preload="pendule-xviii"
  jsonLd={[faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap">
      <div class="grid hero-grid">
        <div class="hero-small" data-reveal><Pic k="bordeaux-gravure" ratio="16-10" eager sizes="(max-width: 860px) 46vw, 25vw" /></div>
        <h1 class="hero-title">
          <span class="mask l1"><span>Antiquaires</span></span>
          <span class="mask l2"><span>du Sud-Ouest</span></span>
        </h1>
        <div class="hero-tall"><Pic k="pendule-xviii" ratio="4-5" eager sizes="(max-width: 860px) 72vw, 30vw" /></div>
        <div class="hero-copy">
          <p class="lead">Expertise, estimation gratuite et rachat de succession dans toute la Nouvelle-Aquitaine et toute l’Occitanie, de Bordeaux à Toulouse, de Limoges à Perpignan.</p>
          <div class="cta-row">
            <a class="btn" href={ESTIMATION_URL}>Estimation gratuite <span class="arr" aria-hidden="true">→</span></a>
            <a class="link" href="/rachat-succession/">Rachat de succession</a>
          </div>
          <ul class="dep-chips" aria-label="Choisir votre zone">
            {REGIONS.map((r) => <li><a class="chip chip--strong" href={zoneUrl(r.slug)} title={`Antiquaire en ${r.name}`}>{r.name}</a></li>)}
            {FEATURED.map((d) => <li><a class="chip" href={zoneUrl(d.slug)} title={`Antiquaire ${d.name} (${d.num}) : ${d.cities.slice(0, 3).join(', ')}`}>{d.name} ({d.num})</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-about">
    <div class="wrap">
      <div class="grid">
        <div class="about-head" data-reveal>
          <h2 class="h-section" id="h-about">Tout le Sud-Ouest, une seule expertise</h2>
          <p class="lead">Vingt-cinq départements, une même exigence : estimer juste, racheter avec respect, accompagner les familles avec discrétion.</p>
        </div>
      </div>
      <div class="grid mosaic">
        <div class="mosaic-photo" data-reveal>
          <Pic k="vezere" ratio="16-10" sizes="(max-width: 860px) 92vw, 62vw" />
          <div class="paper-block"><p>De la Charente-Maritime aux Pyrénées-Orientales, nous connaissons les demeures, les ateliers et les marchés de chaque territoire. Nous estimons vos objets d’art avec la rigueur d’une étude d’expertise.</p></div>
        </div>
        <div class="mosaic-side" data-reveal style="--i:1">
          <div class="tile">
            <svg class="map" viewBox="0 0 360 300" role="img" aria-label="Carte des zones d’intervention en Nouvelle-Aquitaine et en Occitanie">
              {mapPts.map((p) => (
                <a href={zoneUrl(p.d)}>
                  <title>{`Antiquaire à ${p.n}`}</title>
                  <circle cx={p.x} cy={p.y} r="4.5" />
                  <text x={p.a === 'end' ? p.x - 9 : p.x + 9} y={p.y + 4} text-anchor={p.a}>{p.n}</text>
                </a>
              ))}
            </svg>
          </div>
          <dl class="facts">
            <div><dt>Départements couverts</dt><dd>Vingt-cinq</dd></div>
            <div><dt>Régions</dt><dd>Deux</dd></div>
            <div><dt>Estimation</dt><dd>Gratuite</dd></div>
            <div><dt>Première réponse</dt><dd>Sous 48 h</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-band">
    <div class="wrap band-head" data-reveal style="max-width:none;padding-right:var(--m)">
      <h2 class="h-section" id="h-band" style="font-size:clamp(1.8rem,1.2rem + 2vw,2.75rem)">Dans toutes les grandes villes</h2>
    </div>
    <div class="band" data-reveal>
      {[['gironde-33', 'bordeaux-bourse', 'Bordeaux'], ['haute-garonne-31', 'toulouse', 'Toulouse'], ['pyrenees-atlantiques-64', 'biarritz', 'Biarritz'], ['herault-34', 'montpellier', 'Montpellier']].map(([slug, k, city], i) => (
        <a href={zoneUrl(slug)} style={`--g:${[5, 2, 3, 2][i]}`} title={`Antiquaire à ${city}`}>
          <Pic k={k} sizes="(max-width: 860px) 60vw, 40vw" alt={`Antiquaire expert à ${city} : estimation gratuite et rachat`} />
          <span class="scrim"></span>
          <span class="cap">{city}</span>
        </a>
      ))}
    </div>
    <div class="wrap band-note"><p class="small muted">Et dans tous les autres départements : <a href="/zones-intervention/">voir toutes nos zones d’intervention</a>.</p></div>
  </section>

  <section class="section" aria-labelledby="h-steps">
    <div class="wrap">
      <div class="steps-top" data-reveal>
        <h2 class="h-section" id="h-steps" style="font-size:clamp(1.8rem,1.2rem + 2vw,2.75rem)">De votre message au règlement</h2>
        <div class="ctrl"><button class="sq" data-dir="-1" aria-label="Étape précédente">←</button><button class="sq" data-dir="1" aria-label="Étape suivante">→</button></div>
      </div>
      <div class="progress" aria-hidden="true"><i data-progress></i></div>
      <ol class="steps-row" data-steps tabindex="0" aria-label="Les étapes d’une estimation">
        {steps.map((s) => (
          <li class="step">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <div class="gap" style={`--gapv:${s.g}px`}></div>
            <Pic k={s.k} ratio="4-5" sizes="(max-width: 860px) 72vw, 280px" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="h-spec">
    <div class="wrap">
      <h2 class="statement" id="h-spec" data-reveal>Ce que nous expertisons</h2>
      <div class="grid table-wrap">
        <div class="table-side" data-reveal><Pic k="commode-louis-xv" ratio="4-5" sizes="(max-width: 860px) 60vw, 22vw" /></div>
        <p class="table-name">Spécialités</p>
        <ul class="rows">
          {SPECIALITES.map((s, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <a href={`/antiquites/${s.slug}/`} title={`${s.name} : expertise et estimation gratuite`}>
                <b>{s.name}</b>
                <span class="arr" aria-hidden="true">→</span>
                <span class="k">{s.lead.split(':')[0]}</span>
              </a>
            </li>
          ))}
          <li data-reveal><a href="/rachat-succession/"><b>Rachat de succession</b><span class="arr" aria-hidden="true">→</span><span class="k">Inventaire, partage et rachat du contenu d’une maison</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-zones">
    <div class="wrap">
      <h2 class="h-section" id="h-zones" data-reveal style="margin-bottom:56px">Partout dans le Sud-Ouest</h2>
      {REGIONS.map((r) => (
        <div class="grid prose-row region-block" data-reveal>
          <h3 style="grid-column:1/6;font-size:clamp(1.5rem,1.1rem + 1.4vw,2.25rem)"><a href={zoneUrl(r.slug)} style="text-decoration:none">{r.name}</a></h3>
          <ul class="related" style="grid-column:6/13;margin-top:0">
            {deptsOf(r.slug).map((d) => <li><a class="chip" href={zoneUrl(d.slug)} title={`Antiquaire ${d.name} (${d.num}) : ${d.cities.slice(0, 3).join(', ')}`}>{d.name} ({d.num})</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <Faq items={faq} title="Vos questions sur l’estimation" />
  <TallyForm />
  <CtaPhoto k="perigord-chateau" title="Une succession à régler ?" text="Nous rachetons le contenu complet d’une maison : mobilier, tableaux, bijoux et objets d’art. Estimation gratuite, discrétion assurée." label="Parler de ma succession" href="/rachat-succession/" />
</Base>
